# ==============================================================================
# MEKHALFI ERP & DOCUMENT MANAGEMENT - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local PostgreSQL (Docker Compose)
# DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"
#
# Option B: Neon Serverless PostgreSQL (Production Cloud)
# Use the pooled connection string with sslmode=require for serverless (Vercel)
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.c-8.eu-central-1.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require"
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# In production, generate a secure 32+ character random secret (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-secure-random-nextauth-secret-here"
# In local development: http://localhost:3000
# In production: https://<your-app-domain>.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. S3-COMPATIBLE OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Local MinIO (Docker)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="erp-documents"
MINIO_USE_SSL="false"

# Option B: Cloudflare R2 / AWS S3 (Production Cloud)
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="<cloudflare_r2_access_key_id>"
# S3_SECRET_ACCESS_KEY="<cloudflare_r2_secret_access_key>"
# S3_BUCKET="mekhalfi-erp-documents"
# S3_REGION="auto"
