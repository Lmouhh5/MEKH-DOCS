# Database configuration
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"

# NextAuth configuration
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# MinIO S3 Object Storage configuration
# IMPORTANT FOR OFFICE LAN DEPLOYMENT:
# In local development, MINIO_ENDPOINT="localhost" works because browser and server share the machine.
# For office LAN deployment, MINIO_ENDPOINT must be set to the server's static LAN IP or hostname
# (e.g. "192.168.1.50" or "server.local"), NEVER "localhost".
# Reason: Signed document URLs generated for PDF viewing/download include this endpoint;
# client workstations on the office network cannot resolve "localhost" to the central server.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="erp-documents"
MINIO_USE_SSL="false"
